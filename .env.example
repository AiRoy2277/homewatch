# 复制成 .env 再填；.env 已被 .gitignore 忽略，不会提交
# deploy.py / tools/remote.py 启动时自动读取。

HOMEWATCH_HOST=192.168.1.10      # 服务器的内网地址
HOMEWATCH_USER=root
# HOMEWATCH_PORT=22              # SSH 端口，改过才需要写

# root 密码：deploy 需要（或用 SSH_KEY 指私钥）
# SSH_PW=

# Cloudflare：只用来把封禁推到边缘，不填也能跑
# 权限只需要 Zone → Firewall → Edit，别用全局 API Key
# CF_TOKEN=
# CF_ZONE=example.com
